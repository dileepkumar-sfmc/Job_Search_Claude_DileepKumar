# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — never commit real keys.

# ── OpenRouter (recommended) ─────────────────────────────────────────────────
# One key, access to Claude, GPT-4o, Gemini, Llama, and more.
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-...

# Model to use via OpenRouter — see full list at https://openrouter.ai/models
# Examples:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o
#   google/gemini-2.0-flash-001
VITE_OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# ── Direct Anthropic (alternative) ───────────────────────────────────────────
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# ── Direct OpenAI (alternative) ──────────────────────────────────────────────
# VITE_OPENAI_API_KEY=sk-...

# ── Default provider: openrouter | claude | openai ───────────────────────────
VITE_AI_PROVIDER=openrouter
